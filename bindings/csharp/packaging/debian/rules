#!/usr/bin/make -f

# Upstream version (strip the Debian revision) and its major component.
VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)
MAJOR   := $(firstword $(subst ., ,$(VERSION)))

DESTLIB := debian/libiio-csharp/usr/lib
CLIDIR  := $(DESTLIB)/cli/libiio-sharp-$(VERSION)

SOURCES := Attr.cs Channel.cs Context.cs Device.cs IOBuffer.cs \
           Trigger.cs IioLib.cs ScanContext.cs UTF8Marshaler.cs AssemblyInfo.cs

# The csharp dir ships a CMakeLists; override the auto steps so debhelper
# builds the assembly with mcs directly instead of driving CMake.
%:
	dh $@ --with cli

override_dh_auto_configure:
	sed 's/@LIBIIO_CS_VERSION@/$(VERSION).0.0/' AssemblyInfo.cs.in > AssemblyInfo.cs
	sed -e 's#@CMAKE_INSTALL_PREFIX@#/usr#g' -e 's/@VERSION@/$(VERSION)/g' \
		libiio-sharp.pc.cmakein > libiio-sharp-$(VERSION).pc
	sed 's/@LIBIIO_VERSION_MAJOR@/$(MAJOR)/g' \
		libiio-sharp.dll.config.cmakein > libiio-sharp.dll.config

override_dh_auto_build:
	mcs /target:library /out:libiio-sharp.dll /keyfile:key.snk $(SOURCES)

override_dh_auto_test:

override_dh_auto_install:
	install -d $(CLIDIR)
	install -m0644 libiio-sharp.dll $(CLIDIR)/libiio-sharp.dll
	install -m0644 libiio-sharp.dll.config $(CLIDIR)/libiio-sharp.dll.config
	install -D -m0644 libiio-sharp-$(VERSION).pc \
		$(DESTLIB)/pkgconfig/libiio-sharp-$(VERSION).pc
