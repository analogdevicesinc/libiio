/ {
	fake0: fake-iio-device-0 {
		compatible = "iio,fake-iio-device";
		io-name = "fake0";
	};

	fake-iio-device-1 {
		compatible = "iio,fake-iio-device";
	};

	fake-iio-device-2 {
		compatible = "iio,fake-iio-device";
		io-name = "broken";
		fake-fail-init;
	};
};
